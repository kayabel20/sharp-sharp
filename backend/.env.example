# Sharp Sharp Lending Platform - Environment Variables
# Copy to .env and fill in values

# Database
DATABASE_URL=postgresql+asyncpg://sharpsharp:sharpsharp_dev@localhost:5433/sharpsharp_lending

# Redis
REDIS_URL=redis://localhost:6379/0

# JWT
JWT_SECRET_KEY=change-me-in-production
JWT_ALGORITHM=HS256

# ML Service
ML_SERVICE_URL=http://localhost:8001

# Mono (Bank Linking)
MONO_SECRET_KEY=
MONO_PUBLIC_KEY=

# Flutterwave (Disbursement)
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_PUBLIC_KEY=

# Credit Bureaus
CRC_API_URL=
CRC_API_KEY=
FIRST_CENTRAL_API_URL=
FIRST_CENTRAL_API_KEY=
CREDIT_REGISTRY_API_URL=
CREDIT_REGISTRY_API_KEY=

# KYC
METAMAP_API_KEY=
METAMAP_API_SECRET=

# Environment
ENVIRONMENT=development
AUTO_CREATE_TABLES=true
